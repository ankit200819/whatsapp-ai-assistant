# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Optional for local testing; graceful fallback if not connected)
MONGODB_URI=mongodb://localhost:27017/whatsapp_ai

# Free AI Chat Engine Option 1: Google Gemini (High Speed ~1s, 100% Free from https://aistudio.google.com)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Free AI Chat Engine Option 2: Ollama (Offline Local PC)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# WhatsApp Cloud API Configuration (Meta Developer Portal)
WHATSAPP_VERIFY_TOKEN=whatsapp_ai_secret_verify_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
